{
  "name": "park-it",
  "private": true,
  "version": "1.0.0",
  "description": "Live leaderboard for the Park it! flag game at Drava Forester.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:styles && npm run format:check",
    "lint:js": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix && prettier . --write",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.5"
  }
}
